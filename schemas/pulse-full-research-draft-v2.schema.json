          },
          "kind": {
            "type": "string",
            "enum": [
              "financial-observation",
              "issuer-report-metric", "report-excerpt",
              "archived-forecast",
              "research-section",
              "valuation-scenario"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "evidenceId",
          "kind",
          "claim",
          "uncertainty"
        ]
      },
      "maxItems": 100
