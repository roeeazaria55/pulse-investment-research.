{
  "name": "pulse-investment-research",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader runner",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2 --testTimeout=15000 --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "collect": "node scripts/ingest/run.mjs",
    "validate:data": "node scripts/ingest/validate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "ajv": "^8.17.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
